# Weekly Status Report Agent — Environment Variables (template)
# Copy this file to .env and fill in your values:  cp .env.example .env
# This file holds SECRETS and endpoints (KEY=value pairs), loaded via python-dotenv.
# App settings (schedule, labels, projects, etc.) live in config/config.yaml — NOT here.
# .env is gitignored; never commit real credentials.

# ─────────────────────────────────────────────────────────────
# Jira (REQUIRED)
# ─────────────────────────────────────────────────────────────
JIRA_URL=https://your-company.atlassian.net

# Jira Cloud → use email + API token
# Create a token at: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_EMAIL=your-email@company.com
JIRA_API_TOKEN=your-jira-api-token

# Jira Server / Data Center → use username + password instead of the two lines above
# JIRA_USERNAME=your-username
# JIRA_PASSWORD=your-password

# ─────────────────────────────────────────────────────────────
# AI Provider (REQUIRED) — must match ai.provider in config/config.yaml
# Fill in the block for whichever provider you selected there.
# ─────────────────────────────────────────────────────────────

# Option A: Vertex AI (provider: "vertex") — Claude via Google Cloud.
# Uses Application Default Credentials (run: gcloud auth application-default login).
# No API key here — only project/region:
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1

# Option B: Anthropic direct (provider: "anthropic")
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_API_BASE_URL=            # optional, for enterprise/proxy endpoints

# Option C: OpenAI (provider: "openai")
# OPENAI_API_KEY=sk-...

# ─────────────────────────────────────────────────────────────
# GitLab (optional — MR collection is skipped if GITLAB_TOKEN is unset)
# ─────────────────────────────────────────────────────────────
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=your-gitlab-personal-access-token   # needs read_api scope
